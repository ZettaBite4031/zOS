from pathlib import Path
from SCons.Script import File

from UserImages import BuildNativeElf

Import("user_environment", "user_runtime_objects", "output_root")

programs = {}
for role, number in (("Exit", 1), ("Fault", 2), ("Survivor", 3)):
    environment = user_environment.Clone()
    environment.Append(CPPDEFINES=[("ZOS_CITY_ROLE", number)])
    programs[role] = BuildNativeElf(
        environment, output_root, f"City{role}", [Path(Dir(".").srcnode().abspath) / "Main.cpp"],
        user_runtime_objects, File("Linker.ld"),
    )

Return("programs")
